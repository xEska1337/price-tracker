# ---- server ----
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://pricetrack:pricetrack@localhost:5432/pricetrack

# single-user password; leave empty to disable auth
ADMIN_PASSWORD=
SECRET_KEY=

# scraping
DEFAULT_INTERVAL=24h
SCRAPE_POLL_SECONDS=30
SCRAPE_MIN_GAP_PER_DOMAIN=15
HTTP_TIMEOUT=20

# headless-browser fallback (tier 4) for JS-rendered / bot-protected pages
# requires: pip install '.[browser]' && playwright install chromium
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_TIMEOUT_MS=25000
# chromium lives outside HOME in most containers; `make browsers` installs it here
# PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers

# image proxy (hotlink-proofing + caching); can be disabled to load images directly
IMAGE_PROXY_ENABLED=true
IMAGE_CACHE_DIR=./data/image_cache
IMAGE_CACHE_TTL_DAYS=7
IMAGE_CACHE_MAX_MB=256

# Discord notifications (leave the webhook empty to disable)
DISCORD_WEBHOOK_URL=
# only notify when the price drops by at least this percentage (0 = any drop)
DISCORD_MIN_DROP_PCT=0
# add an "all-time low" callout to the notification embed
DISCORD_HIGHLIGHT_ALL_TIME_LOW=true

# pepper.pl feed
RSS_URL=https://www.pepper.pl/rss/wszystkie
RSS_POLL_SECONDS=900
